server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # проксі для доступу через port-forward; в Kubernetes /api обслуговує Ingress
  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
  }

  location / {
    try_files $uri /index.html;
  }
}
